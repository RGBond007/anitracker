# ---------------------------------------------------------------------------
# AniTracker configuration
#
#   cp .env.example .env
#   # set JWT_SECRET (the only value you MUST change)
#   docker compose up -d
#
# Every value below has a working default except JWT_SECRET.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Signs your login sessions. Generate one with:
#   openssl rand -hex 32
# Changing it later logs everyone out. Never commit the real value.
# JWT_SECRET=

# --- Networking -----------------------------------------------------------

# Host port the web UI is published on. http://localhost:8000 by default.
PORT=8000

# Set to true when AniTracker is served over HTTPS (behind Caddy/Traefik/nginx).
# It marks session cookies Secure, so leaving it true on plain HTTP breaks login.
COOKIE_SECURE=false

# --- Database -------------------------------------------------------------
# Used to provision the Postgres container and build the app's DATABASE_URL.
# Change the password before exposing this beyond your LAN.

POSTGRES_USER=anitrack
POSTGRES_PASSWORD=anitrack
POSTGRES_DB=anitrack

# --- Instance policy ------------------------------------------------------

# Whether anyone can create an account from the login screen. Set to false once
# your household/team has signed up -- the first user is always the admin.
ALLOW_SIGNUP=true

# --- Rate limiting --------------------------------------------------------

# Caps repeated hits on login, registration, search and friend requests.
# Counters live in the app process, so they reset on restart and are per-worker.
RATE_LIMIT_ENABLED=true

# Only turn this on behind a reverse proxy you control (Caddy/Traefik/nginx).
# It makes rate limits trust the X-Forwarded-For header to identify the caller --
# and any client can forge that header, so on a directly-exposed instance this
# lets an attacker present a new identity per request and bypass every limit.
TRUST_PROXY=false

# --- Branding (white-labelling) -------------------------------------------

# Shown in the header, the browser tab and the setup wizard.
INSTANCE_NAME=AniTracker

# Absolute URL to a square logo. Leave empty for the built-in mark.
LOGO_URL=

# Any CSS colour. Drives the stamp accent: buttons, focus rings, the halftone
# progress overlay. The default is the muted hanko-stamp gold the UI is designed
# around; an admin can also change it live under Settings -> Instance.
ACCENT_COLOR=#C9A227

# --- Metadata providers ---------------------------------------------------

# Order in which the public metadata APIs are tried. The first one that answers
# wins; the rest are fallbacks for rate limits and outages. All are keyless.
#   anilist - GraphQL, best coverage (romaji/english/native + synonyms)
#   jikan   - unofficial MyAnimeList API, used for MAL id lookups on import
#   kitsu   - JSON:API, locale-keyed titles
PROVIDER_ORDER=anilist,jikan,kitsu

# How long cached titles/covers/synopses are trusted before a re-fetch, in days.
# Raise it to be gentler on the public APIs; lower it to pick up corrections faster.
MEDIA_CACHE_TTL_DAYS=7

# --- Uploads --------------------------------------------------------------

# Where uploaded profile pictures are written. In Docker this is a named volume,
# so avatars survive `docker compose up -d --build`; leave it alone unless you are
# mounting your own storage. Outside Docker it is relative to the working
# directory and created on first upload.
MEDIA_ROOT=/data/media

# Largest profile picture accepted, in bytes. Everything accepted is re-encoded to
# a 512x512 WebP, so this only limits what the server is willing to decode.
MAX_AVATAR_BYTES=5242880

# --- Licensing ------------------------------------------------------------

# AniTracker is open source; the validator is a no-op and accepts anything,
# including an empty value. Reserved for a future paid tier.
LICENSE_KEY=

# --- Telemetry ------------------------------------------------------------
# There is none. AniTracker makes no outbound requests except to the metadata
# providers listed above. There is no setting to change because there is
# nothing to turn off.
